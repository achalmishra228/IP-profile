  /* Ganesha artwork */
  #ganesha path{
    fill:none; stroke:#d4af37; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round;
    stroke-dasharray:1400; stroke-dashoffset:1400; animation:draw 2.4s ease forwards 0.3s;
  }
  #ganesha .fillshape{ fill:#e2872f; opacity:0; animation:fadein 1.4s ease forwards 2s; }
  @keyframes draw{ to{ stroke-dashoffset:0; } }
  @keyframes fadein{ to{ opacity:0.85; } }
  .glow-pulse{
    position:absolute; top:50%; left:50%; width:300px; height:300px; transform:translate(-50%,-50%);
    border-radius:50%; background:radial-gradient(circle, rgba(212,175,55,0.35) 0%, rgba(212,175,55,0) 70%);
    animation:pulse 3.2s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{ opacity:0.5; transform:translate(-50%,-50%) scale(0.9); } 50%{ opacity:1; transform:translate(-50%,-50%) scale(1.12); } }
  .mandala{
    position:absolute; top:50%; left:50%; width:min(80vw,420px); height:min(80vw,420px);
    transform:translate(-50%,-50%); opacity:0.14; animation:spin 100s linear infinite;
  }
  @keyframes spin{ to{ transform:translate(-50%,-50%) rotate(360deg); } }
  .om-mark{ opacity:0; animation:fadein2 1s ease forwards 2.3s; }
  @keyframes fadein2{ to{ opacity:1; } }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; }
    #ganesha path{ stroke-dashoffset:0; }
    #ganesha .fillshape, .om-mark{ opacity:1; }
  }
</style>
